# Скопируйте этот файл в .env.local и подставьте значения из Supabase:
# Project Settings → API (Data API / API Keys).
# .env.local не попадает в git — настоящие ключи храните только там.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# AI-вырезание вещи с фото и создание аватара (Runware). Только для сервера — без префикса
# NEXT_PUBLIC_, поэтому ключ никогда не попадает в браузер.
# Ключ: runware.ai → Dashboard → API Keys.
RUNWARE_API_KEY=your-runware-api-key
# Необязательно: AIR-идентификаторы генеративных моделей (вещи, аватар, примерка).
# По умолчанию google:4@3 (Nano Banana 2). Nano Banana Pro — google:4@2.
# RUNWARE_GARMENT_MODEL=
# RUNWARE_AVATAR_MODEL=
# RUNWARE_TRYON_MODEL=

# ── Оплата ЮKassa (только сервер, без NEXT_PUBLIC_) ─────────────────────────
# Этап 1 — тестовый режим: секретный ключ должен начинаться с test_.
YOOKASSA_SHOP_ID=your-test-shop-id
YOOKASSA_SECRET_KEY=test_your-secret-key
# Сервисный ключ Supabase (Project Settings → API → service_role). Только сервер:
# им сервер записывает подписку после проверки оплаты. Никогда не публикуйте.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Необязательно: адрес сайта для возврата с оплаты (по умолчанию — текущий домен).
# APP_URL=https://mobile-app-jb75.vercel.app

# Секрет для ежедневного автопродления (/api/cron/renew). Любая длинная случайная строка.
# Vercel Cron сам присылает его в заголовке Authorization. Только сервер.
CRON_SECRET=your-long-random-string
