# Скопируйте этот файл в .env.local и подставьте значения из Supabase:
# Project Settings → API (Data API / API Keys).
# .env.local не попадает в git — настоящие ключи храните только там.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Удаление фона с фото вещей (Runware). Только для сервера — без префикса NEXT_PUBLIC_,
# поэтому ключ никогда не попадает в браузер. Ключ: runware.ai → Dashboard → API Keys.
RUNWARE_API_KEY=your-runware-api-key
# Необязательно: AIR-идентификатор модели удаления фона.
# По умолчанию runware:110@1 (Bria RMBG 2.0). Для Ideogram Background Remover
# вставьте его идентификатор из каталога моделей Runware.
# RUNWARE_BG_MODEL=
